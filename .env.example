# --- Metadata providers -------------------------------------------------------

# Google Books API key. Strongly recommended: the anonymous quota is often zero,
# in which case every lookup 429s and falls back to OpenLibrary automatically.
# Create one at https://console.cloud.google.com/apis/credentials ("Books API").
GOOGLE_BOOKS_API_KEY=

# --- Storage ------------------------------------------------------------------

# Where the SQLite file lives. On Fly this must sit on the mounted volume.
BOOKSHELF_DB=data/bookshelf.db

# --- Server -------------------------------------------------------------------

# If set, every /api/* request must send `X-Bookshelf-Token: <value>`.
# Leave empty for local use. REQUIRED once the API is reachable from the internet.
#   Generate one with: openssl rand -hex 24
BOOKSHELF_TOKEN=

# Browser origins allowed to call the API, comma-separated. Needed because the UI
# is served from GitHub Pages while the API runs on Fly.
#
# Origin only — scheme and host, no path and no trailing slash. A Pages project
# site lives at https://<user>.github.io/<repo>/, but the ORIGIN is just
# https://<user>.github.io — including the /<repo> path here silently blocks
# every browser request.
#
# Include http://localhost:8000 as well so a locally served UI can talk to a
# deployed API while you are working on it.
#   e.g. https://<user>.github.io,http://localhost:8000
BOOKSHELF_CORS_ORIGINS=

# Where the static UI lives. Only needed if it isn't next to the package.
# BOOKSHELF_WEB_DIR=/app/web
